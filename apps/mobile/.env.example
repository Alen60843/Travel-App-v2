# Copy to apps/mobile/.env.local (git-ignored) and adjust.
#
# EXPO_PUBLIC_* values are compiled INTO the app bundle and are readable by
# anyone who has the app. Only put public, non-secret values here — never
# API keys, tokens, database credentials or signing material.
#
# Base URL of the TripWith API, including the /api prefix (routes are
# /api/v1/...). A physical phone CANNOT reach your computer via "localhost":
# use your computer's LAN IP (same Wi-Fi), e.g.
#   EXPO_PUBLIC_API_URL=http://192.168.1.50:3000/api
# Android emulator: http://10.0.2.2:3000/api   iOS simulator: http://localhost:3000/api
EXPO_PUBLIC_API_URL=
