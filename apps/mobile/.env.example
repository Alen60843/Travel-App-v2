# Copy to apps/mobile/.env.local (git-ignored) and fill in. Restart Metro after changes.
#
# EXPO_PUBLIC_* values are compiled INTO the app bundle and are readable by
# anyone who has the app. Only put public, non-secret values here — never
# server secrets, service-account JSON, Firebase Admin private keys, database
# credentials, tokens or signing material.

# --- TripWith API -----------------------------------------------------------
# Base URL of the TripWith API, including the /api prefix (routes are
# /api/v1/...). A physical phone CANNOT reach your computer via "localhost",
# and the Expo tunnel only tunnels Metro, not the API. Use one of:
#   LAN (same Wi-Fi):     http://192.168.1.50:3000/api
#   dev HTTPS tunnel:     https://<your-dev-tunnel-host>/api   (see README)
#   Android emulator:     http://10.0.2.2:3000/api
#   iOS simulator:        http://localhost:3000/api
EXPO_PUBLIC_API_URL=

# --- Firebase client (Web app) config ---------------------------------------
# From Firebase console > Project settings > Your apps > Web app config.
# These are public client identifiers, not secrets. The project MUST be the
# same Firebase project as the API's FIREBASE_PROJECT_ID, otherwise the API
# rejects the token (AUTH_TOKEN_WRONG_AUDIENCE).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
